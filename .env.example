# The wedding this build renders. Without it api.ts falls back to `demo-envelop`,
# which is a different wedding and shows the wrong couple.
VITE_DEFAULT_SLUG=

# Override the API host the dev proxy forwards /api to (default https://api.qinvi.id).
VITE_API_PROXY_TARGET=

# Unset (the default) renders the design's own content -- its couple, dates, venues and
# accounts -- and never calls the API. Set to 1 to fetch the wedding named by
# VITE_DEFAULT_SLUG instead.
VITE_LIVE_DATA=
